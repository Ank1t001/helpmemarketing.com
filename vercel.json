{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/team/(.*)",
      "destination": "/api/gone"
    },
    {
      "source": "/category/(.*)",
      "destination": "/api/gone"
    },
    {
      "source": "/2025/(.*)",
      "destination": "/api/gone"
    },
    {
      "source": "/feed",
      "destination": "/api/gone"
    },
    {
      "source": "/(.*)/feed",
      "destination": "/api/gone"
    },
    {
      "source": "/wp-includes",
      "destination": "/api/gone"
    },
    {
      "source": "/wp-includes/(.*)",
      "destination": "/api/gone"
    },
    {
      "source": "/wp-content",
      "destination": "/api/gone"
    },
    {
      "source": "/wp-content/(.*)",
      "destination": "/api/gone"
    },
    {
      "source": "/wp-admin",
      "destination": "/api/gone"
    },
    {
      "source": "/wp-admin/(.*)",
      "destination": "/api/gone"
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/api/gone"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.helpmemarketing.com"
        }
      ],
      "destination": "https://helpmemarketing.com/$1",
      "statusCode": 301
    },
    {
      "source": "/blog/meta-attribution",
      "destination": "/blog/meta-roas-attribution",
      "permanent": true
    },
    {
      "source": "/healthcare-seo",
      "destination": "/services/seo",
      "permanent": true
    },
    {
      "source": "/clinic-websites",
      "destination": "/services/website-development",
      "permanent": true
    },
    {
      "source": "/websites",
      "destination": "/services/website-development",
      "permanent": true
    },
    {
      "source": "/retention",
      "destination": "/services/ai-automation",
      "permanent": true
    },
    {
      "source": "/reputation",
      "destination": "/services/branding-social#reviews",
      "permanent": true
    },
    {
      "source": "/brand",
      "destination": "/services/branding-social",
      "permanent": true
    },
    {
      "source": "/hipaa-checklist",
      "destination": "/industries/healthcare/hipaa-checklist",
      "permanent": true
    },
    {
      "source": "/_healthcare/healthcare-seo",
      "destination": "/industries/healthcare",
      "permanent": true
    },
    {
      "source": "/_healthcare/case-studies",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/_healthcare/hipaa-checklist",
      "destination": "/industries/healthcare/hipaa-checklist",
      "permanent": true
    },
    {
      "source": "/_healthcare/ad-calculator",
      "destination": "/ad-calculator",
      "permanent": true
    },
    {
      "source": "/seo",
      "destination": "/services/seo",
      "permanent": true
    },
    {
      "source": "/google-meta-ads",
      "destination": "/services/performance-marketing",
      "permanent": true
    },
    {
      "source": "/website-design",
      "destination": "/services/website-development",
      "permanent": true
    },
    {
      "source": "/social-media",
      "destination": "/services/branding-social",
      "permanent": true
    },
    {
      "source": "/brand-content",
