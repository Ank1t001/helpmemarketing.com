    },
    {
      "source": "/reviews-reputation",
      "destination": "/services/branding-social#reviews",
      "permanent": true
    },
    {
      "source": "/analytics",
      "destination": "/services/analytics-attribution",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/services-2",
      "destination": "/services",
      "statusCode": 301
    },
    {
      "source": "/servicess/brand-acceleration",
      "destination": "/services/branding-social",
